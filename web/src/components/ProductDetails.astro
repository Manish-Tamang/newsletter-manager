---
import SectionHeading from "./ui/SectionHeading.astro";
import SketchButton from "./ui/SketchButton.astro";
import { appUrl, steps, surfaces } from "../data/site";

const theme = [
  { label: "Alignment", value: "Left, center, or right for every block" },
  { label: "Accent", value: "One color for buttons and the accent bar" },
  { label: "Radius", value: "Card corners that match your product" },
  { label: "Side margin", value: "One gutter the whole letter shares" },
];
---

<section class="page-gutter pt-4 sm:pt-6">
  <div class="paper-panel">
    <div class="mx-auto grid max-w-6xl items-end gap-10 px-6 pb-16 pt-16 sm:pt-24 lg:grid-cols-[1.2fr_1fr] lg:pb-20">
      <SectionHeading as="h1" eyebrow="Product" title="The workspace is the product.">
        Gaida is not a page builder that later becomes email. You compose in
        the same rhythm the inbox will show: one card, one margin, blocks that
        know what sits above them.
      </SectionHeading>

      <dl class="divide-y divide-dashed divide-ink/25 border-y border-dashed border-ink/25 lg:mb-1">
        {
          theme.map((item) => (
            <div class="flex items-baseline justify-between gap-6 py-3">
              <dt class="font-providence text-xl text-ink">{item.label}</dt>
              <dd class="text-right text-[15px] leading-snug text-ink/65">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<section class="page-gutter">
  <div class="mx-auto max-w-6xl px-6 py-24 lg:py-32">
    <SectionHeading eyebrow="How it works" title="Three steps from blank to sent." />

    <ol class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        steps.map((step, index) => (
          <li class="relative">
            <span class="font-providence block text-7xl leading-none text-ink">
              <span class="highlight">{index + 1}</span>
            </span>
            <h3 class="mt-6 text-2xl tracking-tight text-ink">{step.title}</h3>
            <p class="mt-3 text-lg leading-tight text-black/80">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="page-gutter">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 pb-24 lg:grid-cols-[1fr_1.4fr] lg:gap-16 lg:pb-32">
    <div>
      <SectionHeading eyebrow="Inside the app" title="Every room, one click away.">
        These routes are the product. Open any of them when you are ready to work.
      </SectionHeading>
      <div class="mt-9">
        <SketchButton href={appUrl} class="ml-10">Open the app</SketchButton>
      </div>
    </div>

    <ul class="border-t border-dashed border-ink/25">
      {
        surfaces.map((item) => (
          <li class="border-b border-dashed border-ink/25">
            <a
              href={item.href}
              class="group flex items-center justify-between gap-6 py-4 transition-colors"
            >
              <span class="font-providence text-2xl text-ink">
                <span class="group-hover:highlight">{item.name}</span>
              </span>
              <span class="flex items-center gap-3 text-right text-[15px] text-ink/60 transition-colors group-hover:text-ink">
                {item.note}
                <svg
                  class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 10.5c4-.6 9-.4 13.5-.3" />
                  <path d="M12 5.5l4.6 4.7-4.4 4.6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
