---
import SketchButton from "./ui/SketchButton.astro";
import { appUrl } from "../data/site";
---

<section class="page-gutter pt-4 sm:pt-6">
  <div class="paper-panel">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-6 pb-16 pt-16 sm:pt-24 lg:grid-cols-[1.05fr_1fr] lg:gap-6 lg:pb-20"
    >
      <div>
        <h1
          class="font-providence max-w-3xl text-5xl font-normal leading-[1.08] tracking-tight text-zinc-950 sm:text-6xl"
        >
          Write emails that look finished.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-tight text-black">
          Gaida is a block canvas for campaigns, subscribers, and templates.
          Start blank, keep one margin, and send work that already looks like a
          real product email.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <SketchButton href={appUrl} class="ml-10">See demo</SketchButton>
          <a
            href="/product"
            class="text-[15px] text-ink/70 underline decoration-ink/30 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          >
            How it works
          </a>
        </div>
      </div>

      <div
        class="hero-model relative aspect-square w-full sm:aspect-[4/3] lg:aspect-square"
      >
        <model-viewer
          src="/models/pc.glb"
          alt="3D model of a desktop computer"
          camera-controls
          disable-zoom
          auto-rotate
          auto-rotate-delay="0"
          rotation-per-second="6deg"
          interaction-prompt="none"
          shadow-intensity="0.8"
          shadow-softness="1"
          exposure="1"
          environment-image="neutral"
          camera-orbit="-30deg 75deg auto"
          loading="eager"
          class="h-full w-full"
        >
          <div slot="progress-bar"></div>
        </model-viewer>
      </div>
    </div>
  </div>
</section>

<script>
  import "@google/model-viewer";
</script>

<style>
  .hero-model model-viewer {
    --poster-color: transparent;
    background: transparent;
    outline: none;
  }

  .hero-model model-viewer:not(:defined) {
    display: block;
  }
</style>
