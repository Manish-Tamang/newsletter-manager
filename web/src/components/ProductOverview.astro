---
import SectionHeading from "./ui/SectionHeading.astro";
import { features } from "../data/site";
---

<section class="page-gutter">
  <div class="mx-auto max-w-6xl px-6 pb-24 lg:pb-32">
    <SectionHeading eyebrow="What you get" title="Everything a letter needs, nothing it doesn't.">
      The product lives in the app. This site is here so you can see the shape
      of it before you open a workspace.
    </SectionHeading>

    <div class="mt-14 grid border-t border-dashed border-ink/25 sm:grid-cols-2">
      {
        features.map((feature, index) => (
          <article
            class:list={[
              "group border-b border-dashed border-ink/25 py-9 sm:px-8",
              index % 2 === 0 ? "sm:border-r sm:pl-0" : "sm:pr-0",
            ]}
          >
            <span class="eyebrow">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="font-providence mt-3 text-3xl text-ink">
              <span class="group-hover:highlight">{feature.title}</span>
            </h3>
            <p class="mt-3 max-w-md text-lg leading-tight text-black/80">{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
