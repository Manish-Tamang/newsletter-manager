---
import type { PresetId } from "../../data/site";

interface Props {
  id: PresetId;
}

const { id } = Astro.props;
---

<div class="thumb flex h-full flex-col gap-2.5 overflow-hidden rounded-[3px] border border-ink/10 bg-white p-4" aria-hidden="true">
  {
    id === "basic" && (
      <>
        <span class="h-4 w-4 rounded-[3px] bg-ink" />
        <span class="mt-1 h-2.5 w-4/5 rounded-full bg-ink" />
        <span class="line w-full" />
        <span class="line w-11/12" />
        <span class="line w-2/3" />
        <span class="mt-1 h-5 w-16 rounded-[3px] bg-ink" />
        <span class="mt-auto h-px w-full bg-ink/10" />
        <span class="line w-1/2 opacity-60" />
      </>
    )
  }
  {
    id === "security" && (
      <>
        <span class="-mx-4 -mt-4 mb-1 h-1.5 bg-marker" />
        <span class="h-2.5 w-3/4 rounded-full bg-ink" />
        <span class="line w-full" />
        <span class="line w-5/6" />
        <span class="mt-1 rounded-[3px] border border-ink/10 p-2">
          <span class="line block w-1/3 bg-ink/40" />
          <span class="line mt-1.5 block w-full" />
        </span>
        <span class="rounded-[3px] border border-ink/10 p-2">
          <span class="line block w-1/4 bg-ink/40" />
          <span class="line mt-1.5 block w-4/5" />
        </span>
      </>
    )
  }
  {
    id === "code" && (
      <>
        <span class="flex items-center gap-2">
          <span class="h-4 w-4 rounded-full bg-ink" />
          <span class="h-px flex-1 bg-ink/15" />
        </span>
        <span class="mt-1 h-2.5 w-3/5 rounded-full bg-ink" />
        <span class="line w-full" />
        <span class="mt-1 grid place-items-center rounded-[3px] bg-paper py-3 font-mono text-sm font-bold tracking-[0.2em] text-ink">
          482 913
        </span>
        <span class="line w-5/6" />
        <span class="line w-1/2" />
      </>
    )
  }
  {
    id === "product" && (
      <>
        <span class="-mx-4 -mt-4 flex h-14 items-end bg-marker/70 px-4 pb-2">
          <span class="h-2.5 w-2/3 rounded-full bg-ink" />
        </span>
        <span class="line mt-1 w-full" />
        <span class="line w-3/4" />
        <span class="mt-1 flex gap-2 rounded-[3px] border border-ink/10 p-2">
          <span class="h-8 w-8 shrink-0 rounded-[2px] bg-paper-deep" />
          <span class="flex flex-1 flex-col gap-1.5 pt-0.5">
            <span class="line w-3/4 bg-ink/40" />
            <span class="line w-full" />
          </span>
        </span>
      </>
    )
  }
  {
    id === "renewal" && (
      <>
        <span class="h-4 w-4 rounded-[3px] bg-ink" />
        <span class="mt-1 h-2.5 w-2/3 rounded-full bg-ink" />
        <span class="line w-full" />
        <span class="mt-1 h-5 w-20 rounded-[3px] bg-ink" />
        <span class="mt-1 divide-y divide-ink/10 rounded-[3px] border border-ink/10">
          {[0, 1, 2].map(() => (
            <span class="flex justify-between px-2 py-1.5">
              <span class="line block w-1/4 bg-ink/40" />
              <span class="line block w-1/3" />
            </span>
          ))}
        </span>
      </>
    )
  }
</div>

<style>
  /* Layered so Tailwind utilities like bg-ink/40 can still override the tint. */
  @layer components {
    .thumb :global(.line) {
      display: block;
      height: 0.3rem;
      border-radius: 999px;
      background-color: rgb(17 17 17 / 0.14);
    }
  }
</style>
